// PID line follower with lost recovery and barcode reading - NXC
#include "Logger.h"
#include "Peripheral.h"
#include "Pid_Control.h"
#include "HardwareControl.h"
#include "LostRecovery.h"
#include "HillSpeedControl.h"
#include "StateMachine.h"




// =====================================================
// MAIN TASK
// =====================================================
task main() {

    log_init(); // SHOULD BE FIRST TO INITIALIZE!

  
    hardwareControl_init();


    int leftRaw = SensorValue(LEFT_SENSOR);
    int rightRaw = SensorValue(RIGHT_SENSOR);
    int middleRaw = SensorValue(BARCODE_SENSOR);
    int wallDistance = SensorUS(ULTRA_SONIC_SENSOR);

    int leftTacho = 0;
    int rightTacho = 0;

    pid_init(leftRaw, rightRaw);

    stateMachine_init();
  
    bool running = true;

    long timeStart = 0; // Timer increments every ms. HOW SLOW COULD A BE TIMER?!

    while(running) {

        timeStart = CurrentTick();

        // --- SENSOR READINGS ---
        leftRaw = SensorValue(LEFT_SENSOR);
        rightRaw = SensorValue(RIGHT_SENSOR) * SENSOR_TOLERANCE_COMPENSATION_FACTOR;
        middleRaw = SensorValue(MIDDLE_SENSOR);
        wallDistance = SensorUS(ULTRA_SONIC_SENSOR);
        leftTacho = fastAbs(MotorBlockTachoCount(LEFT_MOTOR));
        rightTacho = fastAbs(MotorBlockTachoCount(RIGHT_MOTOR));
        //log_println(NumToStr(wallDistance));


        // --- HILL SPEED CONTROL ---
        hillSpeedControl_update(leftTacho, rightTacho);

        
        // --- LOST RECOVERY ---
        if(lostRecovery_isLost(leftRaw, rightRaw, middleRaw)) {
            log_playAlarm();
            lostRecovery_handleRecovery();
            continue;
        }
        

        // --- PID CONTROL ---
        pid_update(leftRaw, rightRaw);

        int appliedLeft = pid_getLeftPower();
        int appliedRight = pid_getRightPower();


        // --- APPLY POWER ---
        applyMotorPower(LEFT_MOTOR, appliedLeft);
        applyMotorPower(RIGHT_MOTOR, appliedRight);


        // --- STATE MACHINE CONTROL ---
        bool stopLoop = stateMachine_update(leftRaw, middleRaw, rightRaw, wallDistance, leftTacho, rightTacho);

        if(stopLoop) {
            running = false;
        }


        // --- Loop End ---
        //Wait(LOOP_MS);
        while(CurrentTick() - timeStart < LOOP_MS); // Constant timing
        // Loop time independent from program as long as cpu is not overloaded.

    }

    applyMotorPower(LEFT_MOTOR, 0);
    applyMotorPower(RIGHT_MOTOR, 0);

    PlayTone(900, 1000);
    Wait(1000);
}
