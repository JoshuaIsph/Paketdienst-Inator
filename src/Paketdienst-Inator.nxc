// PID line follower with lost recovery and barcode reading - NXC
#include "Logger.h"
#include "Peripheral.h"
#include "Pid_Control.h"
#include "Barcode_Scanner.h"
#include "HardwareControl.h"
#include "LostRecovery.h"
//#include "HillSpeedControl.h"



// =====================================================
// MAIN TASK
// =====================================================
task main() {

  log_init(); // SHOULD BE FIRST TO INITIALIZE!

  
  hardwareControl_init();
  //hillSpeedControl_init();

  /*
    OnFwdRegPID(OUT_BC, 10, OUT_REGMODE_SPEED, PID_7, PID_1, PID_0);

    while(true) {
        Wait(10);
    }
*/

  int leftRaw = SensorValue(LEFT_SENSOR);
  int rightRaw = SensorValue(RIGHT_SENSOR);
  int middleRaw = SensorValue(BARCODE_SENSOR);

  pid_init(leftRaw, rightRaw);

  
  while(true) {
    // read sensors
    leftRaw = SensorValue(LEFT_SENSOR);
    rightRaw = SensorValue(RIGHT_SENSOR);
    middleRaw = SensorValue(MIDDLE_SENSOR);

    //hillSpeedControl_update();
    
    if(lostRecovery_isLost(leftRaw, rightRaw, middleRaw)) {
      lostRecovery_handleRecovery();
      continue;
    }

    // --- PID CONTROL ---
    pid_update(leftRaw, rightRaw);

    int appliedLeft = pid_getLeftPower();
    int appliedRight = pid_getRightPower();



    // --- APPLY POWER ---
    //applyMotorPower(LEFT_MOTOR, appliedLeft);
    //applyMotorPower(RIGHT_MOTOR, appliedRight);

    // --- APPLY SPEED ---
    applyMotorSpeed(LEFT_MOTOR, appliedLeft);
    applyMotorSpeed(RIGHT_MOTOR, appliedRight);

    // --- BARCODE READING ---
    barcode_update(middleRaw);


    // --- Loop End ---
    Wait(LOOP_MS);

  }
}
